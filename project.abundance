      "interpreterVersion": 1,
      "code": "/**\n * A round wire (or cable, hose, tube) routed smoothly between two round edges.\n *\n * Wire the parts in and pick a circular edge on each: on Start Shape where the\n * wire begins and on End Shape where it ends (a hole rim, the end of a pin or\n * terminal). The wire runs from the center of each circle, leaving straight\n * out along the circle's axis, and curves smoothly between them. Each end\n * leaves on the side facing the other end; Flip Start or Flip End sends it\n * out the other side. The wire is as thick as the start circle. For a wire\n * that has to go around something, chain several wires end to end.\n *\n * The centerline is a cubic Bezier curve, and the start circle is swept\n * along it.\n */\ntype V = [number, number, number];\n\nconst add = (a: V, b: V): V => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];\nconst sub = (a: V, b: V): V => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst mul = (a: V, k: number): V => [a[0] * k, a[1] * k, a[2] * k];\nconst dot = (a: V, b: V) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];\nconst cross = (a: V, b: V): V => [\n  a[1] * b[2] - a[2] * b[1],\n  a[2] * b[0] - a[0] * b[2],\n  a[0] * b[1] - a[1] * b[0],\n];\nconst len = (a: V) => Math.sqrt(dot(a, a));\nconst vec = (p: any): V => [p.x ?? p[0], p.y ?? p[1], p.z ?? p[2]];\n\n/** Center, axis and radius of a round edge from three points on it; null if straight. */\nfunction circleOf(edge: any): { center: V; axis: V; radius: number } | null {\n  const a = vec(edge.pointAt(0));\n  const b = vec(edge.pointAt(1 / 3));\n  const c = vec(edge.pointAt(2 / 3));\n  const ab = sub(b, a);\n  const ac = sub(c, a);\n  const n = cross(ab, ac);\n  const n2 = dot(n, n);\n  if (n2 < 1e-12 * dot(ab, ab) * dot(ac, ac)) return null; // collinear: straight edge\n  // Circumcenter of triangle abc\n  const center = add(\n    a,\n    mul(add(mul(cross(n, ab), dot(ac, ac)), mul(cross(ac, n), dot(ab, ab))), 1 / (2 * n2)),\n  );\n  return { center, axis: mul(n, 1 / Math.sqrt(n2)), radius: len(sub(a, center)) };\n}\n\n/** The circle picked on a shape input, with an error that says what to do. */\nfunction pickedCircle(shape: Assembly | undefined, label: string) {\n  const ask = `Pick a circular edge on ${label} Shape for this end of the wire (a hole rim or the end of a pin).`;\n  // An edge input with nothing wired in passes a number, not a shape.\n  if (!shape || typeof (shape as any).getSelectedEdges !== \"function\")\n    throw new Error(`Connect the part the wire ${label === \"Start\" ? \"starts\" : \"ends\"} at to ${label} Shape. ${ask}`);\n  const edges = shape.getSelectedEdges();\n  if (!edges || edges.length === 0) throw new Error(ask);\n  if (edges.length > 1) console.warn(`${label} Shape: ${edges.length} edges picked; using the first.`);\n  const circle = circleOf(edges[0]);\n  if (!circle) throw new Error(`The edge picked on ${label} Shape is straight. ${ask}`);\n  return circle;\n}\n\n/** Sweep a closed profile along a spine with OpenCascade's discrete trihedron. */\nfunction sweepDiscrete(profile: any, spine: any) {\n  const oc = replicad.getOC();\n  const builder = new oc.BRepOffsetAPI_MakePipeShell(spine.wrapped);\n  try {\n    builder.SetDiscreteMode();\n    builder.Add(profile.wrapped, false, true);\n    builder.Build();\n    builder.MakeSolid();\n    return replicad.cast(builder.Shape());\n  } finally {\n    builder.delete();\n  }\n}\n\nfunction run(\n  startShape: Assembly | undefined = undefined, // pick the circular edge the wire starts at\n  endShape: Assembly | undefined = undefined, // pick the circular edge the wire ends at\n  stiffness: number = 0.5, // how far the wire runs straight out before bending\n  flipStart: boolean = false, // leave the start circle out its other side\n  flipEnd: boolean = false, // leave the end circle out its other side\n): Assembly {\n  const stiff = Number(stiffness);\n  if (!(stiff > 0)) throw new Error(\"Stiffness must be more than 0.\");\n\n  const start = pickedCircle(startShape, \"Start\");\n  const end = pickedCircle(endShape, \"End\");\n  const p0 = start.center;\n  const p1 = end.center;\n  const gap = len(sub(p1, p0));\n  if (gap < 1e-6) throw new Error(\"The start and end circles are in the same place.\");\n\n  // A circle's axis points either way: take the side facing the other end,\n  // then let the flip toggle reverse it.\n  const outward = (axis: V, from: V, toward: V, flip: boolean): V => {\n    const d = dot(axis, sub(toward, from)) < 0 ? mul(axis, -1) : axis;\n    return flip === true ? mul(d, -1) : d;\n  };\n  const d0 = outward(start.axis, p0, p1, flipStart);\n  const d1 = outward(end.axis, p1, p0, flipEnd);\n\n  // One cubic Bezier: its control points sit out along each end's direction,\n  // a stiffness fraction of the gap away.\n  const reach = gap * stiff;\n  const spine = replicad.assembleWire([\n    replicad.makeBezierCurve([p0, add(p0, mul(d0, reach)), add(p1, mul(d1, reach)), p1]),\n  ]);\n\n  // Sweep the start circle's size, square to the start direction, along the centerline.\n  const profile = () => replicad.assembleWire([replicad.makeCircle(start.radius, p0, d0)]);\n  let wire;\n  try {\n    wire = sweepDiscrete(profile(), spine);\n  } catch (e) {\n    // The default (corrected Frenet) mode fails on these curves; Frenet works\n    // where the discrete trihedron doesn't.\n    wire = replicad.genericSweep(profile(), spine, { frenet: true });\n  }\n\n  const length = replicad.measureLength(spine);\n  console.log(`Wire: ${(start.radius * 2).toFixed(2)} diameter, ${length.toFixed(1)} long`);\n\n  return new Assembly({ geometry: wire, tags: [\"wire\"] });\n}\n",
      "compiledCode": "\"use strict\";\nconst add = (a, b) => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];\nconst sub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst mul = (a, k) => [a[0] * k, a[1] * k, a[2] * k];\nconst dot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];\nconst cross = (a, b) => [\n    a[1] * b[2] - a[2] * b[1],\n    a[2] * b[0] - a[0] * b[2],\n    a[0] * b[1] - a[1] * b[0],\n];\nconst len = (a) => Math.sqrt(dot(a, a));\nconst vec = (p) => [p.x ?? p[0], p.y ?? p[1], p.z ?? p[2]];\n/** Center, axis and radius of a round edge from three points on it; null if straight. */\nfunction circleOf(edge) {\n    const a = vec(edge.pointAt(0));\n    const b = vec(edge.pointAt(1 / 3));\n    const c = vec(edge.pointAt(2 / 3));\n    const ab = sub(b, a);\n    const ac = sub(c, a);\n    const n = cross(ab, ac);\n    const n2 = dot(n, n);\n    if (n2 < 1e-12 * dot(ab, ab) * dot(ac, ac))\n        return null; // collinear: straight edge\n    // Circumcenter of triangle abc\n    const center = add(a, mul(add(mul(cross(n, ab), dot(ac, ac)), mul(cross(ac, n), dot(ab, ab))), 1 / (2 * n2)));\n    return { center, axis: mul(n, 1 / Math.sqrt(n2)), radius: len(sub(a, center)) };\n}\n/** The circle picked on a shape input, with an error that says what to do. */\nfunction pickedCircle(shape, label) {\n    const ask = `Pick a circular edge on ${label} Shape for this end of the wire (a hole rim or the end of a pin).`;\n    // An edge input with nothing wired in passes a number, not a shape.\n    if (!shape || typeof shape.getSelectedEdges !== \"function\")\n        throw new Error(`Connect the part the wire ${label === \"Start\" ? \"starts\" : \"ends\"} at to ${label} Shape. ${ask}`);\n    const edges = shape.getSelectedEdges();\n    if (!edges || edges.length === 0)\n        throw new Error(ask);\n    if (edges.length > 1)\n        console.warn(`${label} Shape: ${edges.length} edges picked; using the first.`);\n    const circle = circleOf(edges[0]);\n    if (!circle)\n        throw new Error(`The edge picked on ${label} Shape is straight. ${ask}`);\n    return circle;\n}\n/** Sweep a closed profile along a spine with OpenCascade's discrete trihedron. */\nfunction sweepDiscrete(profile, spine) {\n    const oc = replicad.getOC();\n    const builder = new oc.BRepOffsetAPI_MakePipeShell(spine.wrapped);\n    try {\n        builder.SetDiscreteMode();\n        builder.Add(profile.wrapped, false, true);\n        builder.Build();\n        builder.MakeSolid();\n        return replicad.cast(builder.Shape());\n    }\n    finally {\n        builder.delete();\n    }\n}\nfunction run(startShape = undefined, // pick the circular edge the wire starts at\nendShape = undefined, // pick the circular edge the wire ends at\nstiffness = 0.5, // how far the wire runs straight out before bending\nflipStart = false, // leave the start circle out its other side\nflipEnd = false) {\n    const stiff = Number(stiffness);\n    if (!(stiff > 0))\n        throw new Error(\"Stiffness must be more than 0.\");\n    const start = pickedCircle(startShape, \"Start\");\n    const end = pickedCircle(endShape, \"End\");\n    const p0 = start.center;\n    const p1 = end.center;\n    const gap = len(sub(p1, p0));\n    if (gap < 1e-6)\n        throw new Error(\"The start and end circles are in the same place.\");\n    // A circle's axis points either way: take the side facing the other end,\n    // then let the flip toggle reverse it.\n    const outward = (axis, from, toward, flip) => {\n        const d = dot(axis, sub(toward, from)) < 0 ? mul(axis, -1) : axis;\n        return flip === true ? mul(d, -1) : d;\n    };\n    const d0 = outward(start.axis, p0, p1, flipStart);\n    const d1 = outward(end.axis, p1, p0, flipEnd);\n    // One cubic Bezier: its control points sit out along each end's direction,\n    // a stiffness fraction of the gap away.\n    const reach = gap * stiff;\n    const spine = replicad.assembleWire([\n        replicad.makeBezierCurve([p0, add(p0, mul(d0, reach)), add(p1, mul(d1, reach)), p1]),\n    ]);\n    // Sweep the start circle's size, square to the start direction, along the centerline.\n    const profile = () => replicad.assembleWire([replicad.makeCircle(start.radius, p0, d0)]);\n    let wire;\n    try {\n        wire = sweepDiscrete(profile(), spine);\n    }\n    catch (e) {\n        // The default (corrected Frenet) mode fails on these curves; Frenet works\n        // where the discrete trihedron doesn't.\n        wire = replicad.genericSweep(profile(), spine, { frenet: true });\n    }\n    const length = replicad.measureLength(spine);\n    console.log(`Wire: ${(start.radius * 2).toFixed(2)} diameter, ${length.toFixed(1)} long`);\n    return new Assembly({ geometry: wire, tags: [\"wire\"] });\n}\n"
    },
